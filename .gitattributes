# Normalize text files to LF on checkout (consistent across platforms)
* text=auto eol=lf

# EPICS State Notation Language (.st)
*.st text linguist-language=C

# Common EPICS text/config files
*.db text
*.dbd text
*.template text
*.subs text
*.cmd text
*.req text
*.proto text

# Scripts and build files
*.sh text eol=lf
Makefile text

# Images and other binaries
*.png binary -diff -merge
*.jpg binary -diff -merge
*.jpeg binary -diff -merge
*.gif binary -diff -merge
*.bmp binary -diff -merge
*.ico binary -diff -merge

# Optional: treat archives as binary too
*.zip binary -diff -merge
*.tar binary -diff -merge
*.gz  binary -diff -merge
*.xz  binary -diff -merge
